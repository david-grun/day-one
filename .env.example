# Blank locally uses persistent embedded PostgreSQL in .dayone/db.
# Vercel REQUIRES a hosted PostgreSQL connection URL.
DATABASE_URL=
DAYONE_DB_PATH=.dayone/db
ANALYTICS_EXPORT_DIR=bi/export
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Optional genuine Microsoft-generated HTTPS embed URL and mode.
POWER_BI_EMBED_URL=
POWER_BI_EMBED_MODE=public
POWER_BI_SNAPSHOT_AT=
